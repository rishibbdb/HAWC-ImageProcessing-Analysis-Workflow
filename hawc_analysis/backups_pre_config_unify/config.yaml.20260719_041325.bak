##Select fitting procedure
fitting_procedure: 'Drips'  # Options: 'Drips', 'Alps' ##If fitting_procedure is 'Drips', specify the following parameters: coord_sys, roi_x and roi_y (in degrees) for the region of interest around the source, and the coordinate system (C for celestial, G for galactic).
coordinates:  
  coord_sys: 'C'    #Coordinate system: C for celestial, G for galactic  
  ra: 83.5    #Specify the right ascension (RA) or longitude (L) in degrees for the center of the region of interest (ROI)   
  dec: 22.0     #Specify the declination (Dec) or latitude (B) in degrees for the center of the region of interest (ROI)  
  l: null  
  b: null  
  roi_x: 4.0  #Specify the size of the region of interest (ROI) in degrees along the x-axis (RA or L)  
  roi_y: 4.0   #Specify the size of the region of interest (ROI) in degrees along the y-axis (Dec or B)  
  create_sig_map: false  #Set to true if you want to generate a significance map for the ROI, false otherwise  
  sig_map_path: /Users/rishi/Documents/Analysis/data/aligned-ml-wholesky-neg-ext0.0.fits.gz #if sig_map is true, specify the path to your precomputed sigmap  
  count_map_dir: /Users/rishi/Documents/Analysis/data/fhitcountmaps/  #if sig_map is true, specify the directory containing your count maps   
  image_bins : [B2C0, B3C0, B4C0, ] #B5C0, B6C0, B7C0, B8C0, B9C0, B10C0] #if sig_map is true, specify the bins to be used for the significance map generation 
  generate_seed_only: false  #Set to true if you want to generate a seed model only, without performing the full fitting procedure, false otherwise
  detector_response: /Users/rishi/Documents/Analysis/data/detRes-fhit2pct-pass5f-mlp-refit.root #Path to detector response file  
  
fitting:  
  map_tree: /Users/rishi/Documents/Analysis/data/maptree-fhit2pct-pass5f-mlp-chunk1-1510.root #Path to maptree file  
  detector_response: /Users/rishi/Documents/Analysis/data/detRes-fhit2pct-pass5f-mlp-refit.root #Path to detector response file  
  estimator: P5_nhit #Choose the estimator to be used for the fitting procedure. Options: P5_nhit, P5_NN_2D, P5_GP_2D  
  bins: [B2C0, B3C0, B4C0, ] #B5C0, B6C0, B7C0, B8C0, B9C0, B10C0] #bins to be used for the fitting procedure  
  fit_name: 'crab_fit' #Name for the fit, used for output files  
  output_dir: /Users/rishi/Documents/Analysis/Sources/AstroImageDetection-fitmodel/HAWC-ImageProcessing-3MLFit/ #Directory where the output files will be saved  
  no_retries: 3 #Number of retries for the fitting procedure in case of failure  
  alternate_spectral_models: ['LogParabola',] #List of alternate spectral models to be tested during the fitting procedure.  Options: 'LogParabola', 'ExponentialCutoffPowerLaw' 

roi:  
  roi_radius: 15  
  use_roi_template: false #Set to true if you want to use a custom ROI template, false otherwise  
  roi_template_path:  #Path to the custom ROI template, if use_image_seed_roi is true  
  generate_roi_template: false #if use_roi_template is true and roi_template does not exist, specify if you want to generate a new ROI template or use an existing one. Set to true to generate a new template, false to use an existing one.   
  use_image_seed_roi: false #Set to true if you want to use an image-based seed model for the ROI, false otherwise  
  custom_roi_ra_min: null #Specify the minimum RA (or L) in degrees for the custom ROI template, if use_image_seed_roi is false and use_roi_template is true  
  custom_roi_ra_max: null #Specify the maximum RA (or L) in degrees for the custom ROI template, if use_image_seed_roi is true  
  custom_roi_dec_min: null #Specify the minimum Dec (or B) in degrees for the custom ROI template, if use_image_seed_roi is true  
  custom_roi_dec_max: null #Specify the maximum Dec (or B) in degrees for the custom ROI template, if use_image_seed_roi is true 

diffuse:  
  use_diffuse_background: true  # Include Diffuse Background Emission  
  diffuse_template_path: null #Optional path to a DBE template file if use_diffuse_background is true  
  generate_diffuse_template: false #Set to true if you want to generate a diffuse background template, false otherwise  
  free_diffuse_norm: true #Set to true if you want to free the normalization of the diffuse background model during fitting, false otherwise 

likelihood_thresholds:  
  point_source_detection: 25  
  extension_test: 16  
  spectrum_test: 16 

error_and_TS:  
  error_point: true #Set to true if you want to compute the errors for point source phase, false otherwise  
  error_extension: true #Set to true if you want to compute the errors for extension test phase, false otherwise  
  error_spectrum: true #Set to true if you want to compute the errors for spectrum test phase, false otherwise  
  compute_TS_point: true #Set to true if you want to compute the TS for point sources, false otherwise  