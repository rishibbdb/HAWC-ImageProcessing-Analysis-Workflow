spectrum.K = 1.7800681691820138e-22 * fluxUnit
spectrum.K.fix = False
spectrum.K.bounds = (1e-29, 1e-19) * fluxUnit

spectrum.piv = 2000000000.0 
spectrum.piv.fix = True
spectrum.piv.bounds = (None, None) 

spectrum.index = -0.6130480039052133 
spectrum.index.fix = False
spectrum.index.bounds = (-10.0, 10.0) 

spectrum.xc = 10215598016.14129 
spectrum.xc.fix = True
spectrum.xc.bounds = (1000000000.0, 200000000000.0) 

Source1.position.ra.bounds = (270.3881313466892, 276.3881313466892) * threeML.u.degree
