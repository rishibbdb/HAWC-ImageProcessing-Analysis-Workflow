source_name = 'URM'

spectrum = threeML.Powerlaw()
shape = threeML.Hermes(fits_file='/Users/rishi/Documents/Analysis/Sources/J1813/Hermes3D-allchan.fits.gz', ihdu=0.0)
URM = threeML.ExtendedSource(source_name, spatial_shape=shape, spectral_shape=spectrum)
fluxUnit = 1. / (threeML.u.keV * threeML.u.cm ** 2 * threeML.u.s)

spectrum.K = 1.0 * fluxUnit
spectrum.K.fix = True
spectrum.K.bounds = (1e-30, 1000.0) * fluxUnit

spectrum.piv = 1.0 
spectrum.piv.fix = True
spectrum.piv.bounds = (None, None) 

spectrum.index = 0.0 
spectrum.index.fix = True
spectrum.index.bounds = (-10.0, 10.0) 

shape.N = 10.543302240696951 
shape.N.fix = False
shape.N.bounds = (0.01, 100.0) 

#-----------END_SOURCE-----------#

