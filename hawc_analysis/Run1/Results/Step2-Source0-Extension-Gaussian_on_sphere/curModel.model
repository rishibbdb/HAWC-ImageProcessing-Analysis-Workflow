source_name = 'Source1'

spectrum = threeML.Powerlaw()
Source1 = threeML.PointSource(source_name, ra=273.3829975822111, dec=-17.744203808399234, spectral_shape=spectrum)
fluxUnit = 1. / (threeML.u.keV * threeML.u.cm ** 2 * threeML.u.s)

spectrum.K = 9.340720659201345e-22 * fluxUnit
spectrum.K.fix = False
spectrum.K.bounds = (1e-26, 1e-20) * fluxUnit

spectrum.piv = 2000000000.0 
spectrum.piv.fix = True
spectrum.piv.bounds = (None, None) 

spectrum.index = -2.451849454521328 
spectrum.index.fix = False
spectrum.index.bounds = (-3.0, -1.0) 

Source1.position.ra.bounds = (270.3881313466892, 276.3881313466892) * threeML.u.degree
Source1.position.ra.free = False

Source1.position.dec.bounds = (-20.771011291553847, -14.771011291553847) * threeML.u.degree
Source1.position.dec.free = False

#-----------END_SOURCE-----------#

